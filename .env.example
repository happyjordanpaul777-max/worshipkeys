# Private settings for each laptop. Never commit the real .env file.
APP_NAME=WorshipKeys
SECRET_KEY=replace-with-a-long-random-secret
# Use the EXTERNAL PostgreSQL URL from Render > Database > Connect.
# Keep this URL private; it contains database credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Local mode: no accounts or admin; both laptops share this songbook.
LOCAL_SHARED_MODE=true
COOKIE_SECURE=false
PUBLIC_BASE_URL=http://127.0.0.1:8000
