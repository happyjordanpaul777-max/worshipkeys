# Copy this file to .env on EACH laptop. Never commit the real .env file.
APP_NAME=WorshipKeys
SECRET_KEY=replace-with-a-long-random-secret
# Paste the EXTERNAL PostgreSQL connection URL from Render's Connect page.
# Keep the username/password private. Do not share this URL or upload it to GitHub.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
ADMIN_EMAIL=happyjordanpaul777@gmail.com
# Use a new, strong password (at least 10 characters); keep it private.
ADMIN_PASSWORD=replace-with-a-strong-unique-password
SESSION_DAYS=14
COOKIE_SECURE=false
PUBLIC_BASE_URL=http://127.0.0.1:8000
